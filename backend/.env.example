# Copy to backend/.env (git-ignored) and fill in real values.

# Required. Base64-encoded 32-byte key that signs the session cookie.
# Generate one with: head -c 32 /dev/urandom | base64
SESSION_HASH_KEY=

# Optional. Set to true once the site is served over HTTPS; the session
# cookie is then only sent over HTTPS.
COOKIE_SECURE=false
